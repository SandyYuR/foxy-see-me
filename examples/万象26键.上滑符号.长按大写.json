      "ref": "rime.BackSpace",
      "keyType": "FUNCTION",
      "swipe": {
        "up": {
          "ref": "qwerty.backspace.up"
        }
      },
      "longPress": {
        "repeat": true,
        "action": {
          "type": "key",
          "key": "BACKSPACE"
        }
      }
    },
