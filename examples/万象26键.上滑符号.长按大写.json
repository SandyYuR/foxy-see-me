    "qwerty.backspace.up": {
      "label": "Esc",
      "tap": {
        "ref": "rime.Escape"
      },
      "variants": [
        {
          "when": {
            "rime": {
              "composing": false
            }
          },
          "tap": {
            "macro": "clear_all"
          },
          "label": "清空"
        }
      ]
    },
