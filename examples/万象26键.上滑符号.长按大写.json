        "up": {
          "type": "key",
          "key": "ENTER",
          "meta": [
            "CTRL"
          ],
          "label": "编码"
        }
      }
    },
    "qwerty.slash": {
      "ref": "rime.slash",
      "swipe": {
        "up": {
          "ref": "rime.grave"
        }
      }
    }
