      "label": "Tab",
      "tap": {
        "ref": "rime.Tab"
      }
    },
    "qwerty.layout": {
      "ref": "foxy.LayoutNumpad",
      "tap": {
        "action": {
          "type": "switch_layout",
          "layout": "numpad"
        }
      },
      "textSize": 15
    },
