{
  "keys": {
    "qwerty.q": { "ref": "rime.q", "swipe": { "up": { "ref": "rime.1" } }, "longPress": { "popupKey": "q" } },
    "qwerty.w": { "ref": "rime.w", "swipe": { "up": { "ref": "rime.2" } }, "longPress": { "popupKey": "w" } },
    "qwerty.e": { "ref": "rime.e", "swipe": { "up": { "ref": "rime.3" } }, "longPress": { "popupKey": "e" } },
    "qwerty.r": { "ref": "rime.r", "swipe": { "up": { "ref": "rime.4" } }, "longPress": { "popupKey": "r" } },
    "qwerty.t": { "ref": "rime.t", "swipe": { "up": { "ref": "rime.5" } }, "longPress": { "popupKey": "t" } },
    "qwerty.y": { "ref": "rime.y", "swipe": { "up": { "ref": "rime.6" } }, "longPress": { "popupKey": "y" } },
    "qwerty.u": { "ref": "rime.u", "swipe": { "up": { "ref": "rime.7" } }, "longPress": { "popupKey": "u" } },
    "qwerty.i": { "ref": "rime.i", "swipe": { "up": { "ref": "rime.8" } }, "longPress": { "popupKey": "i" } },
    "qwerty.o": { "ref": "rime.o", "swipe": { "up": { "ref": "rime.9" } }, "longPress": { "popupKey": "o" } },
    "qwerty.p": { "ref": "rime.p", "swipe": { "up": { "ref": "rime.0" } }, "longPress": { "popupKey": "p" } },
    "qwerty.a": { "ref": "rime.a", "swipe": { "up": { "ref": "rime.at" } }, "longPress": { "popupKey": "a" } },
    "qwerty.s": { "ref": "rime.s", "swipe": { "up": { "ref": "rime.asciicircum" } }, "longPress": { "popupKey": "s" } },
    "qwerty.d": { "ref": "rime.d", "swipe": { "up": { "ref": "rime.numbersign" } }, "longPress": { "popupKey": "d" } },
    "qwerty.f": { "ref": "rime.f", "swipe": { "up": { "ref": "rime.asterisk" } }, "longPress": { "popupKey": "f" } },
    "qwerty.g": { "ref": "rime.g", "swipe": { "up": { "ref": "rime.KP_Add" }, "down": { "label": "单手", "action": { "type": "app", "command": "one_handed" } } }, "longPress": { "popupKey": "g" } },
    "qwerty.h": { "ref": "rime.h", "swipe": { "up": { "ref": "rime.minus" }, "down": { "ref": "rime.Home", "label": "行首" } }, "longPress": { "popupKey": "h" } },
    "qwerty.j": { "ref": "rime.j", "swipe": { "up": { "ref": "rime.backslash" }, "down": { "ref": "rime.End", "label": "行尾" } }, "longPress": { "popupKey": "j" } },
    "qwerty.k": { "ref": "rime.k", "swipe": { "up": { "ref": "rime.parenleft" } }, "longPress": { "popupKey": "k" } },
    "qwerty.l": { "ref": "rime.l", "swipe": { "up": { "ref": "rime.parenright" } }, "longPress": { "popupKey": "l" } },
    "qwerty.z": { "ref": "rime.z", "swipe": { "up": { "ref": "rime.grave" }, "down": { "label": "符号", "action": { "type": "app", "command": "symbols" } } }, "longPress": { "popupKey": "z" } },
    "qwerty.x": { "ref": "rime.x", "swipe": { "up": { "ref": "rime.ApostropheShift" }, "down": { "label": "表情", "action": { "type": "app", "command": "emoji" } } }, "longPress": { "popupKey": "x" } },
    "qwerty.c": { "ref": "rime.c", "swipe": { "up": { "ref": "rime.apostrophe" }, "down": { "label": "颜文", "action": { "type": "app", "command": "kaomoji" } } }, "longPress": { "popupKey": "c" } },
    "qwerty.v": { "ref": "rime.v", "swipe": { "up": { "ref": "rime.semicolon" }, "down": { "label": "粘贴", "ref": "foxy.Paste" } }, "longPress": { "popupKey": "v" } },
    "qwerty.b": { "ref": "rime.b", "swipe": { "up": { "ref": "rime.percent" }, "down": { "label": "全选", "ref": "foxy.SelectAll" } }, "longPress": { "popupKey": "b" } },
    "qwerty.n": { "ref": "rime.n", "swipe": { "up": { "ref": "rime.colon" }, "down": { "label": "撤销", "ref": "foxy.Undo" } }, "longPress": { "popupKey": "n" } },
    "qwerty.m": { "ref": "rime.m", "swipe": { "up": { "ref": "rime.slash" }, "down": { "label": "重做", "ref": "foxy.Redo" } }, "longPress": { "popupKey": "m" } },
    "qwerty.backspace.up": { "label": "Esc", "tap": { "ref": "rime.Escape" }, "variants": [ { "when": { "rime": { "composing": false } }, "tap": { "macro": "clear_all" }, "label": "清空" } ] },
    "qwerty.backspace": { "ref": "rime.BackSpace", "keyType": "FUNCTION", "swipe": { "up": { "ref": "qwerty.backspace.up" } }, "longPress": { "repeat": true, "action": { "type": "key", "key": "BACKSPACE" } } },
    "qwerty.layout.up": { "label": "Tab", "tap": { "ref": "rime.Tab" } },
    "qwerty.layout": { "ref": "foxy.LayoutNumpad", "textSize": 17 },
    "qwerty.comma": { "ref": "rime.comma", "swipe": { "up": { "ref": "rime.exclam" } } },
    "qwerty.space": { "ref": "rime.space", "statusLabel": { "source": "schema_name" }, "swipe": { "up": { "ref": "rime.Up", "label": "" }, "down": { "ref": "rime.Down", "label": "" }, "left": { "ref": "rime.Left", "label": "" }, "right": { "ref": "rime.Right", "label": "" } }, "hold": { "start": { "type": "app", "command": "voice_start" }, "end": { "type": "app", "command": "voice_stop" } }, "textSize": 16 },
    "qwerty.period": { "ref": "rime.period", "swipe": { "up": { "ref": "rime.Question" } } },
    "qwerty.enter": { "ref": "rime.Return", "keyType": "ACTION", "icon": "enter", "swipe": { "up": { "label": "编码", "action": { "type": "key", "key": "ENTER", "meta": [ "SHIFT" ] } } } }
  },
  "actions": {
    "select_all": { "type": "key", "key": "A", "meta": [ "CTRL" ] },
    "delete": { "type": "key", "key": "BACKSPACE" }
  },
  "macros": {
    "clear_all": [ { "action": "select_all" }, { "action": "delete" } ]
  },
  "layouts": {
    "default": {
      "sections": [
        {
          "type": "rows",
          "rows": [
            [
              { "ref": "qwerty.q" },
              { "ref": "qwerty.w" },
              { "ref": "qwerty.e" },
              { "ref": "qwerty.r" },
              { "ref": "qwerty.t" },
              { "ref": "qwerty.y" },
              { "ref": "qwerty.u" },
              { "ref": "qwerty.i" },
              { "ref": "qwerty.o" },
              { "ref": "qwerty.p" }
            ],
            {
              "width": 0.9,
              "keys": [
                { "ref": "qwerty.a" },
                { "ref": "qwerty.s" },
                { "ref": "qwerty.d" },
                { "ref": "qwerty.f" },
                { "ref": "qwerty.g" },
                { "ref": "qwerty.h" },
                { "ref": "qwerty.j" },
                { "ref": "qwerty.k" },
                { "ref": "qwerty.l" }
              ]
            },
            [
              { "ref": "foxy.Shift", "weight": 1.5, "override": { "keyType": "FUNCTION", "icon": "shift", "swipe": { "up": { "ref": "qwerty.layout.up" } }, "longPress": { "action": { "type": "modifier", "modifier": "SHIFT", "state": "LOCKED" } } } },
              { "ref": "qwerty.z" },
              { "ref": "qwerty.x" },
              { "ref": "qwerty.c" },
              { "ref": "qwerty.v" },
              { "ref": "qwerty.b" },
              { "ref": "qwerty.n" },
              { "ref": "qwerty.m" },
              { "ref": "qwerty.backspace", "weight": 1.5 }
            ],
            [
              { "ref": "qwerty.layout", "weight": 1.5 },
              { "ref": "qwerty.comma", "weight": 1.0 },
              { "ref": "qwerty.space", "weight": 5.0 },
              { "ref": "qwerty.period", "weight": 1.0 },
              { "ref": "qwerty.enter", "weight": 1.5 }
            ]
          ]
        }
      ]
    },
    "numpad": {
      "sections": [
        {
          "type": "grid",
          "columns": 5,
          "rows": 4,
          "keys": [
            { "column": 0, "row": 0, "ref": "rime.KP_Add", "keyType": "FUNCTION" },
            { "column": 1, "row": 0, "ref": "rime.KP_1" },
            { "column": 2, "row": 0, "ref": "rime.KP_2" },
            { "column": 3, "row": 0, "ref": "rime.KP_3" },
            { "column": 4, "row": 0, "ref": "rime.KP_Divide", "keyType": "FUNCTION" },
            { "column": 0, "row": 1, "ref": "rime.KP_Subtract", "keyType": "FUNCTION" },
            { "column": 1, "row": 1, "ref": "rime.KP_4" },
            { "column": 2, "row": 1, "ref": "rime.KP_5" },
            { "column": 3, "row": 1, "ref": "rime.KP_6" },
            { "column": 4, "row": 1, "ref": "rime.KP_Equal", "override": { "keyType": "FUNCTION", "label": "V", "tap": { "ref": "rime.V" } } },
            { "column": 0, "row": 2, "ref": "rime.KP_Multiply", "keyType": "FUNCTION" },
            { "column": 1, "row": 2, "ref": "rime.KP_7" },
            { "column": 2, "row": 2, "ref": "rime.KP_8" },
            { "column": 3, "row": 2, "ref": "rime.KP_9" },
            { "column": 4, "row": 2, "ref": "rime.BackSpace", "override": { "swipe": null, "keyType": "FUNCTION", "longPress": { "repeat": true, "action": { "type": "key", "key": "BACKSPACE" } } } },
            { "column": 0, "row": 3, "ref": "foxy.LayoutDefault", "textSize": 17 },
            { "column": 1, "row": 3, "ref": "rime.space", "label": "␣", "keyType": "FUNCTION" },
            { "column": 2, "row": 3, "ref": "rime.KP_0" },
            { "column": 3, "row": 3, "ref": "rime.KP_Decimal", "keyType": "FUNCTION" },
            { "column": 4, "row": 3, "ref": "foxy.KP_Enter" }
          ]
        }
      ]
    }
  },
  "type": "foxy.keyboard-layout"
}