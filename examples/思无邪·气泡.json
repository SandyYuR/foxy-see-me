                    {"ref": "qwerty.period"}, {"ref": "rime.equal"}, {"ref": "num.0"}, {"ref": "qwerty.slash"},
                    {"ref": "foxy.Spacer", "weight": 0.5},
                    {"ref": "qwerty.apostrophe"}, {"ref": "qwerty.space", "weight": 2}, {"ref": "qwerty.enter", "weight": 2}
                ]
              }
            ]
          }
        ]
      }
    },



    "editor": {
      "sections": [
        {
          "type": "rows",
          "rows": [
            [
              { "ref": "editor.escape" },
              { "ref": "editor.home" },
              { "ref": "editor.up" },
              { "ref": "editor.end" },
              { "ref": "editor.delete" }
            ],
            [
              { "ref": "editor.selectAll" },
              { "ref": "editor.selectLeft" },
              { "ref": "editor.selectDown" },
              { "ref": "editor.selectUp" },
              { "ref": "editor.selectRight" }
            ],
            [
              { "ref": "editor.pageUp" },
              { "ref": "editor.left" },
              { "ref": "editor.down" },
              { "ref": "editor.right" },
              { "ref": "editor.pageDown" }
            ],
            [
              { "ref": "editor.default" },
              { "ref": "editor.insert" },
              { "ref": "editor.undo" },
              { "ref": "editor.redo" },
              { "ref": "editor.cut" },
              { "ref": "editor.copy" },
              { "ref": "editor.paste" },
              { "ref": "editor.backspace" }
            ]
          ]
        }
      ]
    },



    "numpad": {
      "sections": [
        {
          "type": "grid",
          "columns": 6,
          "rows": 5,
          "keys": [

            { "column": 0, "row": 0, "label": "@", "tap": { "type": "text", "text": "@" }, "keyType": "FUNCTION" },
            { "column": 0, "row": 1, "label": "&", "tap": { "type": "text", "text": "&" }, "keyType": "FUNCTION" },
            { "column": 0, "row": 2, "label": ",", "tap": { "type": "text", "text": "," }, "keyType": "FUNCTION" },
            { "column": 0, "row": 3, "label": "^", "tap": { "type": "text", "text": "^" }, "keyType": "FUNCTION" },
            { "column": 0, "row": 4, "label": "%", "tap": { "type": "text", "text": "%" }, "keyType": "FUNCTION" },

            { "column": 1, "row": 0, "label": "#", "tap": { "type": "text", "text": "#" }, "keyType": "FUNCTION" },
            { "column": 1, "row": 1, "ref": "rime.KP_Add", "override": { "keyType": "FUNCTION" } },
            { "column": 1, "row": 2, "ref": "rime.KP_Subtract", "override": { "keyType": "FUNCTION" } },
            { "column": 1, "row": 3, "ref": "rime.KP_Multiply", "override": { "keyType": "FUNCTION" } },
            { "column": 1, "row": 4, "ref": "rime.KP_Divide", "override": { "keyType": "FUNCTION" } },

            { "column": 2, "row": 0, "label": "()", "tap": { "macro": "bracket_pair1" }, "keyType": "FUNCTION" },
            { "column": 2, "row": 1, "ref": "rime.KP_1" },
            { "column": 2, "row": 2, "ref": "rime.KP_4" },
            { "column": 2, "row": 3, "ref": "rime.KP_7" },
            { "column": 2, "row": 4, "ref": "rime.KP_Equal" },

            { "column": 3, "row": 0, "label": "[]", "tap": { "macro": "bracket_pair2" }, "keyType": "FUNCTION" },
            { "column": 3, "row": 1, "ref": "rime.KP_2" },
            { "column": 3, "row": 2, "ref": "rime.KP_5" },
            { "column": 3, "row": 3, "ref": "rime.KP_8" },
            { "column": 3, "row": 4, "ref": "rime.KP_0" },

            { "column": 4, "row": 0, "label": "{}", "tap": { "macro": "bracket_pair3" }, "keyType": "FUNCTION" },
            { "column": 4, "row": 1, "ref": "rime.KP_3" },
            { "column": 4, "row": 2, "ref": "rime.KP_6" },
            { "column": 4, "row": 3, "ref": "rime.KP_9" },
            { "column": 4, "row": 4, "ref": "rime.KP_Decimal" },

            { "column": 5, "row": 0, "ref": "foxy.LayoutDefault" },
            { "column": 5, "row": 1, "ref": "rime.space", "label": "␣" , "longPress": { "label": "␣", "repeat": true, "action": { "type": "key", "key": "SPACE" } } },
            { "column": 5, "row": 2, "ref": "rime.BackSpace" , "longPress": { "label": "⌫", "repeat": true, "action": { "type": "key", "key": "BACKSPACE" } } },
            { "column": 5, "row": 3, "rowSpan": 2, "ref": "rime.KP_Enter" , "longPress": { "repeat": true, "action": { "type": "key", "key": "ENTER" } } , "override": { "keyType": "ACTION", "icon": "enter" } }
          ]
        }
      ]
    }
  }
